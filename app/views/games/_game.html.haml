= turbo_frame_tag dom_id(game) do
  #chessboard
    - 8.times do |row|
      .row{"data-row": row}
        - 8.times do |square|
          .square{"data-row": row, "data-col": square}
            - piece = game.instance.board.squares[row][square]
            - if piece
              = image_tag "pieces/#{piece.color}_#{piece.name}.png"

  #side
    #next
      .title State
      #state= game.instance.state
      #error= game.instance.last_error
    #moves
      %ul#moves_list
        - game.instance.moves.each do |m|
          %li= m.to_s