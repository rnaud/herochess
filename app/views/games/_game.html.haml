= turbo_frame_tag dom_id(game) do
  #chessboard
    - 8.times do |row|
      .row{"data-row": row}
        - 8.times do |square|
          .square{"data-row": row, "data-col": square, "data-square": Helper.pt([row, square])}
            - piece = game.board.squares[row][square]
            - if piece
              .piece= image_tag "pieces/#{piece.color}_#{piece.name}.png"

  #side
    #next
      .title State
      #state= game.state
      #errors
        - game.errors.each do |e|
          = e.message
    #moves
      %ul#moves_list
        - game.board.moves.each do |m|
          %li= m.to_s