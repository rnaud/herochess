= turbo_frame_tag dom_id(game) do
  #chessboard
    - 8.times do |row|
      .row{"data-row": row}
        - 8.times do |square|
          .square{"data-row": row, "data-col": square}
            - piece = game.instance.board.squares[row][square]
            - if piece
              = image_tag "pieces/#{piece.color}_#{piece.name}.png"