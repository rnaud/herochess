= turbo_frame_tag dom_id(game) do
  #chessboard{data: {fen: game.fen}}
    - 8.times do |row|
      .row{"data-row": row}
        - 8.times do |square|
          - data = square_data(row, square)
          .square{data: data, id: data[:id]}
            - piece = game.board.squares[row][square]
            - if piece
              - if (translate = translate_str(game, piece))
                #last-moved.transition.piece{data: {moves: piece.possible_moves_str}, style: translate}
                  = image_tag "pieces/#{piece.color}_#{piece.name}.png"
              - else
                .piece{data: {moves: piece.possible_moves_str}}
                  = image_tag "pieces/#{piece.color}_#{piece.name}.png"

  #game-info.block
    %h4 State
    #versus= "versus: #{game.versus}"
    #state= "status: #{game.state}"
    #errors
      - game.errors.each do |e|
        = e.message
    #moves
      %ul#moves_list
        - game.board.moves.each do |m|
          %li= m.to_s