= turbo_frame_tag dom_id(game) do
  #chessboard{data: {fen: game.fen}}
    - 8.times do |row|
      .row{"data-row": row}
        - 8.times do |square|
          - square_id = Helper.pt([row, square])
          .square{data: {row: row, col: square, square: square_id}, id: "square_#{square_id}"}
            - piece = game.board.squares[row][square]
            - if piece
              .piece{data: {moves: piece.possible_moves_str}}
                = image_tag "pieces/#{piece.color}_#{piece.name}.png"

  #game-info.side-block
    #next
      .title State
      #state= game.state
      #errors
        - game.errors.each do |e|
          = e.message
    #moves
      %ul#moves_list
        - game.board.moves.each do |m|
          %li= m.to_s