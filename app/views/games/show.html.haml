#game
  #player-header.block
    %h4#player #{@player} player
    - if @player == :white
      #invite
        = link_to "Link to invite black to play", game_path(@game, color: :black)

  #board_and_state
    = turbo_stream_from "game_#{@game.id}"
    = render @game

  #messages-container.block
    %h3 Messages
    #messages
      = turbo_stream_from "game_#{@game.id}_messages"
      = turbo_frame_tag "game_#{@game.id}_messages" do
        = render @game.messages.last(20)

    = form_with model: Message.new, id: "messages_form", data: { controller: "reset-form", action: 'turbo:submit-end->reset-form#reset' } do |form|
      = form.hidden_field :game_id, value: @game.id
      = form.text_field :message
      = form.submit

  .block
    = link_to "Destroy", @game, method: :delete, data: { confirm: "Are you sure?" }

= form_with model: @game, id: "move_form", data: { controller: "chessboard", action: 'turbo:submit-end->chessboard#move' } do |form|
  = form.hidden_field :color, value: @player
  = form.text_field :from
  = form.text_field :to
  = form.submit "Send"