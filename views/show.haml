#game
  #board
  #side
    #player You are the #{@player} player
    - if @player == :white
      #invite
        %a{href: "/game/#{@uuid}"} Link to invite black to play
    #next
      .title State
      #state
      #error
    #moves
      %ul#moves_list

:javascript
  window.game = #{@game.to_json}

%form#moves_form
  %input{type: "hidden", name: "uuid", value: @uuid}
  %input#from{type: "text", name: "from", placeholder: "From"}
  %input#to{type: "text", name: "to", placeholder: "To"}
  %input{type: "submit"}

#msgs